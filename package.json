{
  "name": "@acme/eslint-plugin-graphql",
  "version": "1.0.0",
  "description": "Acme GraphQL schema standards, enforced as ESLint rules over .graphql SDL.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lint": "./lib/lint.js"
  },
  "files": [
    "index.js",
    "bin/",
    "lib/",
    "rules/",
    "README.md",
    "README-DEVS.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^10.10.0",
    "graphql": "^16.9.0"
  },
  "overrides": {
    "@microsoft/eslint-formatter-sarif": {
      "eslint": "$eslint"
    },
    "test-exclude": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://acme.jfrog.io/artifactory/api/npm/npm-local/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "UNLICENSED",
  "private": false,
  "bin": {
    "graphql-lint": "./bin/cli.js"
  },
  "devDependencies": {
    "jest": "^30.5.1"
  }
}
