{
  "name": "acme-graphql-lint",
  "private": true,
  "scripts": {
    "lint": "cd .. && eslint --config .lint/eslint.config.mjs \"**/*.graphql\"",
    "check-rules": "npm outdated @acme/eslint-plugin-graphql",
    "update-rules": "npm update @acme/eslint-plugin-graphql && npm run lint",
    "upgrade-rules": "npm install @acme/eslint-plugin-graphql@latest && npm run lint"
  },
  "dependencies": {
    "@acme/eslint-plugin-graphql": "^1.0.0"
  },
  "overrides": {
    "@microsoft/eslint-formatter-sarif": {
      "eslint": "^10.10.0"
    }
  }
}
